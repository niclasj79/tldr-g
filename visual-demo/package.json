{
  "name": "tldrg-visual-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TLDR-G Visual Demo \u2014 an interactive four-rung knowledge terrain: the engine's architecture with the hood up, on a synthetic corpus.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "publish-build": "node scripts/build-publish.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "check": "node scripts/check-discipline.mjs",
    "verify:questions": "node scripts/verify-questions.mjs",
    "verify:shell": "node scripts/verify-shell.mjs",
    "shots": "node scripts/shoot.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright": "^1.48.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
